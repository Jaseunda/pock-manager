{
  "name": "mycoolgame",
  "version": "0.1.0",
  "description": "A cool game built with Pockage!",
  "dependencies": {
    "sdl2": "2.28.5",
    "imgui": "1.89.9"
  },
  "build": {
    "compiler": "g++",
    "cpp_version": "c++17",
    "output": "build/mycoolgame",
    "include_paths": [
      "include",
      "libs/sdl2/include",
      "libs/imgui/"
    ],
    "lib_paths": [
      "libs/sdl2/lib"
    ],
    "link_libraries": [
      "SDL2"
    ],
    "build_flags": "-Wall -Wextra"
  },
  "run": {
    "executable": "build/mycoolgame"
  }
} 