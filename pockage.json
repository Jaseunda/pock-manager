{
  "name": "pock-manager",
  "display_name": "Pock Manager",
  "bundle_identifier": "com.jasenunda.pockmanager",
  "version": "0.1.0",
  "description": "A new project built with Pockage!",
  "author": "JASENUNDA",
  "copyright": "Copyright © 2023 JASENUNDA. All rights reserved.",
  "platforms": {
    "macos": {
      "enabled": true,
      "build": {
        "compiler": "clang++",
        "cpp_version": "c++17",
        "output": "build/macos/pock-manager",
        "include_paths": [
          "include"
        ],
        "build_flags": "-Wall -Wextra"
      }
    },
    "windows": {
      "enabled": false,
      "build": {
        "compiler": "g++",
        "cpp_version": "c++17",
        "output": "build/windows/pock-manager.exe",
        "include_paths": [
          "include"
        ],
        "build_flags": "-Wall -Wextra"
      }
    },
    "linux": {
      "enabled": true,
      "build": {
        "compiler": "g++",
        "cpp_version": "c++17",
        "output": "build/linux/pock-manager",
        "include_paths": [
          "include"
        ],
        "build_flags": "-Wall -Wextra"
      }
    },
    "ios": {
      "enabled": true,
      "build": {
        "compiler": "clang++",
        "cpp_version": "c++17",
        "output": "build/ios/pock-manager",
        "include_paths": [
          "include"
        ],
        "build_flags": "-Wall -Wextra -arch arm64 -isysroot $(xcrun --sdk iphoneos --show-sdk-path)"
      }
    },
    "android": {
      "enabled": false,
      "build": {
        "compiler": "clang++",
        "cpp_version": "c++17",
        "output": "build/android/libpock-manager.so",
        "include_paths": [
          "include"
        ],
        "build_flags": "-Wall -Wextra -fPIC -shared"
      }
    }
  },
  "run": {
    "executable": "build/darwin/pock-manager"
  }
}